# Server only. Never prefix secrets with VITE_.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Official API ID for DeepSeek-V4.1-Flash. All profiles use this model, thinking disabled.
DEEPSEEK_MODEL=deepseek-flash
# Optional explicit alternative: AI_PROVIDER=gemini. No automatic paid fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=
GEMINI_LITE_MODEL=
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated Firebase UIDs permitted to use paid AI; empty disables AI.
AI_ALLOWED_UIDS=
# Set to 1 on Render; keep 0 locally.
TRUST_PROXY_HOPS=0

# Public browser configuration. Empty Firebase config keeps guest mode available.
# Empty API base uses same-origin development API; production must use Render URL.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)
