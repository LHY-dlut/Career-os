rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owned() { return signedIn() && resource.data.userId == request.auth.uid; }
    function selfWrite(id) { return signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.id == id; }
    function allowedCollection(name) {
      return name in ['knowledgeArticles', 'questions', 'reviewHistory', 'codingProblems', 'codingAttempts', 'applications', 'interviews', 'interviewQuestions', 'mockInterviewSessions'];
    }
    function ownsAfter(name, id) {
      return getAfter(/databases/$(database)/documents/$(name)/$(id)).data.userId == request.auth.uid;
    }
    function validLinks(name) {
      return (name != 'interviews' || ownsAfter('applications', request.resource.data.applicationId))
        && (name != 'interviewQuestions' || (ownsAfter('interviews', request.resource.data.interviewId)
          && (!('questionId' in request.resource.data) || ownsAfter('questions', request.resource.data.questionId))))
        && (name != 'reviewHistory' || ownsAfter('questions', request.resource.data.questionId))
        && (name != 'codingAttempts' || ownsAfter('codingProblems', request.resource.data.problemId));
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.userId == uid;
    }
    match /{name}/{id} {
      allow read: if allowedCollection(name) && owned();
      allow create: if allowedCollection(name) && selfWrite(id) && validLinks(name);
      allow update: if allowedCollection(name) && owned() && selfWrite(id) && validLinks(name);
      allow delete: if allowedCollection(name) && owned();
    }
  }
}
